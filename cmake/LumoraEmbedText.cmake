# Turns a text file into a C++ string literal (included between `=` and `;`), split into
# adjacent raw-string pieces so no single literal exceeds MSVC's 16 KB limit.
#   cmake -DIN=<file> -DOUT=<file.inc> -P LumoraEmbedText.cmake
file(READ "${IN}" text)
string(REPLACE "\r\n" "\n" text "${text}")
set(out "")
set(piece "")
string(LENGTH "${text}" remaining)
while(remaining GREATER 0)
    string(FIND "${text}" "\n" newline)
    if(newline EQUAL -1)
        set(line "${text}")
        set(text "")
    else()
        math(EXPR cut "${newline} + 1")
        string(SUBSTRING "${text}" 0 ${cut} line)
        string(SUBSTRING "${text}" ${cut} -1 text)
    endif()
    string(APPEND piece "${line}")
    string(LENGTH "${piece}" pieceLength)
    if(pieceLength GREATER 4000)
        string(APPEND out "R\"LUMORA(${piece})LUMORA\"\n")
        set(piece "")
    endif()
    string(LENGTH "${text}" remaining)
endwhile()
if(NOT piece STREQUAL "")
    string(APPEND out "R\"LUMORA(${piece})LUMORA\"\n")
endif()
file(WRITE "${OUT}" "${out}")
